{
  "name": "@vybz/mcp-server",
  "version": "1.1.0",
  "description": "MCP server for the VYBZ API — Provenance (watermark, verify, attribute) and Vault (version control for DAW projects).",
  "license": "MIT",
  "type": "module",
  "bin": { "vybz-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./tools": "./dist/tools.js"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": ["mcp", "model-context-protocol", "audio", "provenance", "watermark", "c2pa", "daw", "version-control", "vybz"]
}
