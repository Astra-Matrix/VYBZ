# VYBZ — environment template. Copy to `.env.local` (git-ignored). Never commit secrets.

# ── Console client (public) ──────────────────────────────────────────────────
# Supabase project xixmneooyufbeftdfpcm (us-west-1)
VITE_SUPABASE_URL=https://xixmneooyufbeftdfpcm.supabase.co
VITE_SUPABASE_ANON_KEY=
# VITE_APP_URL=https://vybz.cloud

# ── Paddle (public, client-side) ─────────────────────────────────────────────
# Environment is required and must be exactly "sandbox" or "live"; the pricing page
# refuses to guess. The client-side token is public by design (test_… or live_…).
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
# Price ids for the Business plan in that environment (sandbox ids shown).
VITE_PADDLE_PRICE_BUSINESS_MONTH=pri_01m1ybdqphgqerhccne3my186b
VITE_PADDLE_PRICE_BUSINESS_YEAR=pri_01m1yrnhtqh0q9q60e23zvvbz7

# ── Feature flags ────────────────────────────────────────────────────────────
# (none)

# ── Supabase Edge secrets (set with `supabase secrets set`; never VITE_) ──────
# WM_SECRET=                  # required — HMAC root for watermark keys (openssl rand -hex 32)
# API_PUBLIC_BASE=https://vybz.cloud/v1
# C2PA_WORKER_URL=            # optional — Content Credentials signer (worker/c2pa)
# C2PA_WORKER_TOKEN=
# STRIPE_SECRET_KEY=            # subscriptions (billing-checkout, stripe-webhook, billing-usage-report)
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BUSINESS=        # optional recurring price id; inline $249/mo fallback
# BILLING_CRON_SECRET=          # x-cron-secret for billing-usage-report

# ── Vercel (server) ──────────────────────────────────────────────────────────
# VYBZ_API_BASE=https://vybz.cloud/v1   # hosted MCP → API

# ── Local MCP ────────────────────────────────────────────────────────────────
# VYBZ_API_KEY=vybz_live_…
# VYBZ_API_BASE=http://127.0.0.1:54321/functions/v1/api-v1/v1   # when serving the function locally
# VYBZ_ROOTS=D:/Projects

# ── Tooling only ─────────────────────────────────────────────────────────────
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=xixmneooyufbeftdfpcm
